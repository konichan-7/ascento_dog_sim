<mujoco model="ascento_dog_quadruped">
  <compiler angle="radian" inertiafromgeom="true" balanceinertia="true"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"
          iterations="100" tolerance="1e-10"/>
  <statistic center="0 0 0.28" extent="0.85"/>

  <visual>
    <global azimuth="135" elevation="-20"/>
    <scale jointlength="0.035" jointwidth="0.008"/>
  </visual>

  <default>
    <joint axis="0 -1 0" damping="0.05" armature="0.001"/>
    <geom type="capsule" size="0.012" density="550" contype="0" conaffinity="0"/>
    <site type="sphere" size="0.008" group="2"/>
  </default>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" mark="edge"
             width="512" height="512" rgb1="0.20 0.30 0.40"
             rgb2="0.10 0.20 0.30" markrgb="0.80 0.80 0.80"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="4 4"
              texuniform="true" reflectance="0.15"/>
    <material name="chassis_mat" rgba="0.14 0.17 0.21 1"/>
    <material name="frame_mat" rgba="0.20 0.22 0.26 1"/>
    <material name="driver_mat" rgba="0.91 0.31 0.24 1"/>
    <material name="upper_mat" rgba="0.19 0.49 0.74 1"/>
    <material name="lower_mat" rgba="0.23 0.68 0.45 1"/>
    <material name="wheel_mat" rgba="0.08 0.09 0.11 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -1.5 1.8" dir="0 0.6 -1"/>
    <camera name="overview" pos="1.1 -1.3 0.9"
            xyaxes="0.763 0.646 0 -0.215 0.253 0.943"/>
    <geom name="floor" type="plane" pos="0 0 0" size="1.5 1.5 0.05"
          material="floor_mat" contype="1" conaffinity="1"/>

    <!--
      Illustrative chassis: 0.60 x 0.36 x 0.15 m.
      Reference height makes the four nominal-pose wheels tangent to z=0.
    -->
    <body name="chassis" pos="0 0 0.3693091272">
      <freejoint name="floating_base"/>
      <geom name="chassis_box" type="box" size="0.30 0.18 0.075"
            material="chassis_mat"/>
      <site name="imu_site" pos="0 0 0.02" size="0.004" rgba="1 0.8 0 0.5"/>

      <!-- Front-left leg: local analytical +x points toward chassis -x
           (knee bends rearward, toward the travel-opposite side). -->
      <body name="front_left_mount" pos="0.24 0.20 0" quat="0 0 0 1">
        <geom name="front_left_frame_AB" fromto="0 0 0 0.0769968574 0 0.0769968574"
              size="0.014" material="frame_mat"/>
        <geom name="front_left_hip_housing" type="cylinder" pos="0 0 0"
              size="0.037 0.020" quat="0.7071067812 0.7071067812 0 0"
              material="frame_mat"/>
        <site name="front_left_point_A" pos="0 0 0" rgba="1 0.3 0.2 1"/>
        <site name="front_left_point_B" pos="0.0769968574 0 0.0769968574"
              rgba="1 0.8 0.1 1"/>
        <body name="front_left_driver_AD" quat="0.9396926208 0 0.3420201433 0">
          <joint name="front_left_hip_drive" range="-0.4363323130 0.4363323130"/>
          <geom name="front_left_link_AD" fromto="0 0 0 0.238 0 0"
                material="driver_mat"/>
          <site name="front_left_point_D" pos="0.238 0 0" rgba="1 0.3 0.2 1"/>
          <body name="front_left_lower_DCE" pos="0.238 0 0"
                quat="0.7655608359 0 -0.6433635104 0">
            <joint name="front_left_inner_passive" range="-1.2 1.2"/>
            <geom name="front_left_link_DCE" fromto="-0.235 0 0 0.057 0 0"
                  material="lower_mat"/>
            <site name="front_left_point_C_lower" pos="0.057 0 0"
                  rgba="0.9 0.2 0.9 1"/>
            <site name="front_left_point_C" pos="0.057 0 0" rgba="0.9 0.2 0.9 0"/>
            <site name="front_left_point_E" pos="-0.235 0 0" rgba="0.2 1 0.4 1"/>
            <body name="front_left_wheel" pos="-0.235 0 0">
              <joint name="front_left_wheel_spin" axis="0 -1 0" damping="0.01"/>
              <geom name="front_left_wheel_geom" type="cylinder" size="0.065 0.025"
                    quat="0.7071067812 0.7071067812 0 0" material="wheel_mat"
                    contype="1" conaffinity="1" friction="1.0 0.01 0.001"/>
            </body>
          </body>
        </body>
        <body name="front_left_upper_BC" pos="0.0769968574 0 0.0769968574"
              quat="0.8973219461 0 0.4413766249 0">
          <joint name="front_left_pin_passive" range="-1.2 1.2"/>
          <geom name="front_left_link_BC" fromto="0 0 0 0.244 0 0"
                material="upper_mat"/>
          <site name="front_left_point_C_upper" pos="0.244 0 0"
                rgba="0.9 0.2 0.9 0.45"/>
        </body>
      </body>

      <!-- Front-right leg. -->
      <body name="front_right_mount" pos="0.24 -0.20 0" quat="0 0 0 1">
        <geom name="front_right_frame_AB" fromto="0 0 0 0.0769968574 0 0.0769968574"
              size="0.014" material="frame_mat"/>
        <geom name="front_right_hip_housing" type="cylinder" pos="0 0 0"
              size="0.037 0.020" quat="0.7071067812 0.7071067812 0 0"
              material="frame_mat"/>
        <site name="front_right_point_A" pos="0 0 0" rgba="1 0.3 0.2 1"/>
        <site name="front_right_point_B" pos="0.0769968574 0 0.0769968574"
              rgba="1 0.8 0.1 1"/>
        <body name="front_right_driver_AD" quat="0.9396926208 0 0.3420201433 0">
          <joint name="front_right_hip_drive" range="-0.4363323130 0.4363323130"/>
          <geom name="front_right_link_AD" fromto="0 0 0 0.238 0 0"
                material="driver_mat"/>
          <site name="front_right_point_D" pos="0.238 0 0" rgba="1 0.3 0.2 1"/>
          <body name="front_right_lower_DCE" pos="0.238 0 0"
                quat="0.7655608359 0 -0.6433635104 0">
            <joint name="front_right_inner_passive" range="-1.2 1.2"/>
            <geom name="front_right_link_DCE" fromto="-0.235 0 0 0.057 0 0"
                  material="lower_mat"/>
            <site name="front_right_point_C_lower" pos="0.057 0 0"
                  rgba="0.9 0.2 0.9 1"/>
            <site name="front_right_point_C" pos="0.057 0 0" rgba="0.9 0.2 0.9 0"/>
            <site name="front_right_point_E" pos="-0.235 0 0" rgba="0.2 1 0.4 1"/>
            <body name="front_right_wheel" pos="-0.235 0 0">
              <joint name="front_right_wheel_spin" axis="0 -1 0" damping="0.01"/>
              <geom name="front_right_wheel_geom" type="cylinder" size="0.065 0.025"
                    quat="0.7071067812 0.7071067812 0 0" material="wheel_mat"
                    contype="1" conaffinity="1" friction="1.0 0.01 0.001"/>
            </body>
          </body>
        </body>
        <body name="front_right_upper_BC" pos="0.0769968574 0 0.0769968574"
              quat="0.8973219461 0 0.4413766249 0">
          <joint name="front_right_pin_passive" range="-1.2 1.2"/>
          <geom name="front_right_link_BC" fromto="0 0 0 0.244 0 0"
                material="upper_mat"/>
          <site name="front_right_point_C_upper" pos="0.244 0 0"
                rgba="0.9 0.2 0.9 0.45"/>
        </body>
      </body>

      <!-- Rear-left leg: same local +x direction as both front legs. -->
      <body name="rear_left_mount" pos="-0.24 0.20 0" quat="0 0 0 1">
        <geom name="rear_left_frame_AB" fromto="0 0 0 0.0769968574 0 0.0769968574"
              size="0.014" material="frame_mat"/>
        <geom name="rear_left_hip_housing" type="cylinder" pos="0 0 0"
              size="0.037 0.020" quat="0.7071067812 0.7071067812 0 0"
              material="frame_mat"/>
        <site name="rear_left_point_A" pos="0 0 0" rgba="1 0.3 0.2 1"/>
        <site name="rear_left_point_B" pos="0.0769968574 0 0.0769968574"
              rgba="1 0.8 0.1 1"/>
        <body name="rear_left_driver_AD" quat="0.9396926208 0 0.3420201433 0">
          <joint name="rear_left_hip_drive" range="-0.4363323130 0.4363323130"/>
          <geom name="rear_left_link_AD" fromto="0 0 0 0.238 0 0"
                material="driver_mat"/>
          <site name="rear_left_point_D" pos="0.238 0 0" rgba="1 0.3 0.2 1"/>
          <body name="rear_left_lower_DCE" pos="0.238 0 0"
                quat="0.7655608359 0 -0.6433635104 0">
            <joint name="rear_left_inner_passive" range="-1.2 1.2"/>
            <geom name="rear_left_link_DCE" fromto="-0.235 0 0 0.057 0 0"
                  material="lower_mat"/>
            <site name="rear_left_point_C_lower" pos="0.057 0 0"
                  rgba="0.9 0.2 0.9 1"/>
            <site name="rear_left_point_C" pos="0.057 0 0" rgba="0.9 0.2 0.9 0"/>
            <site name="rear_left_point_E" pos="-0.235 0 0" rgba="0.2 1 0.4 1"/>
            <body name="rear_left_wheel" pos="-0.235 0 0">
              <joint name="rear_left_wheel_spin" axis="0 -1 0" damping="0.01"/>
              <geom name="rear_left_wheel_geom" type="cylinder" size="0.065 0.025"
                    quat="0.7071067812 0.7071067812 0 0" material="wheel_mat"
                    contype="1" conaffinity="1" friction="1.0 0.01 0.001"/>
            </body>
          </body>
        </body>
        <body name="rear_left_upper_BC" pos="0.0769968574 0 0.0769968574"
              quat="0.8973219461 0 0.4413766249 0">
          <joint name="rear_left_pin_passive" range="-1.2 1.2"/>
          <geom name="rear_left_link_BC" fromto="0 0 0 0.244 0 0"
                material="upper_mat"/>
          <site name="rear_left_point_C_upper" pos="0.244 0 0"
                rgba="0.9 0.2 0.9 0.45"/>
        </body>
      </body>

      <!-- Rear-right leg. -->
      <body name="rear_right_mount" pos="-0.24 -0.20 0" quat="0 0 0 1">
        <geom name="rear_right_frame_AB" fromto="0 0 0 0.0769968574 0 0.0769968574"
              size="0.014" material="frame_mat"/>
        <geom name="rear_right_hip_housing" type="cylinder" pos="0 0 0"
              size="0.037 0.020" quat="0.7071067812 0.7071067812 0 0"
              material="frame_mat"/>
        <site name="rear_right_point_A" pos="0 0 0" rgba="1 0.3 0.2 1"/>
        <site name="rear_right_point_B" pos="0.0769968574 0 0.0769968574"
              rgba="1 0.8 0.1 1"/>
        <body name="rear_right_driver_AD" quat="0.9396926208 0 0.3420201433 0">
          <joint name="rear_right_hip_drive" range="-0.4363323130 0.4363323130"/>
          <geom name="rear_right_link_AD" fromto="0 0 0 0.238 0 0"
                material="driver_mat"/>
          <site name="rear_right_point_D" pos="0.238 0 0" rgba="1 0.3 0.2 1"/>
          <body name="rear_right_lower_DCE" pos="0.238 0 0"
                quat="0.7655608359 0 -0.6433635104 0">
            <joint name="rear_right_inner_passive" range="-1.2 1.2"/>
            <geom name="rear_right_link_DCE" fromto="-0.235 0 0 0.057 0 0"
                  material="lower_mat"/>
            <site name="rear_right_point_C_lower" pos="0.057 0 0"
                  rgba="0.9 0.2 0.9 1"/>
            <site name="rear_right_point_C" pos="0.057 0 0" rgba="0.9 0.2 0.9 0"/>
            <site name="rear_right_point_E" pos="-0.235 0 0" rgba="0.2 1 0.4 1"/>
            <body name="rear_right_wheel" pos="-0.235 0 0">
              <joint name="rear_right_wheel_spin" axis="0 -1 0" damping="0.01"/>
              <geom name="rear_right_wheel_geom" type="cylinder" size="0.065 0.025"
                    quat="0.7071067812 0.7071067812 0 0" material="wheel_mat"
                    contype="1" conaffinity="1" friction="1.0 0.01 0.001"/>
            </body>
          </body>
        </body>
        <body name="rear_right_upper_BC" pos="0.0769968574 0 0.0769968574"
              quat="0.8973219461 0 0.4413766249 0">
          <joint name="rear_right_pin_passive" range="-1.2 1.2"/>
          <geom name="rear_right_link_BC" fromto="0 0 0 0.244 0 0"
                material="upper_mat"/>
          <site name="rear_right_point_C_upper" pos="0.244 0 0"
                rgba="0.9 0.2 0.9 0.45"/>
        </body>
      </body>
    </body>
  </worldbody>

  <equality>
    <connect name="front_left_closure" site1="front_left_point_C_lower"
             site2="front_left_point_C_upper" solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
    <connect name="front_right_closure" site1="front_right_point_C_lower"
             site2="front_right_point_C_upper" solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
    <connect name="rear_left_closure" site1="rear_left_point_C_lower"
             site2="rear_left_point_C_upper" solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
    <connect name="rear_right_closure" site1="rear_right_point_C_lower"
             site2="rear_right_point_C_upper" solref="0.002 1"
             solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <!-- Torque limits remain illustrative until actuator identification. -->
    <motor name="front_left_hip_motor" joint="front_left_hip_drive"
           ctrlrange="-40 40" ctrllimited="true"/>
    <motor name="front_right_hip_motor" joint="front_right_hip_drive"
           ctrlrange="-40 40" ctrllimited="true"/>
    <motor name="rear_left_hip_motor" joint="rear_left_hip_drive"
           ctrlrange="-40 40" ctrllimited="true"/>
    <motor name="rear_right_hip_motor" joint="rear_right_hip_drive"
           ctrlrange="-40 40" ctrllimited="true"/>
    <motor name="front_left_wheel_motor" joint="front_left_wheel_spin"/>
    <motor name="front_right_wheel_motor" joint="front_right_wheel_spin"/>
    <motor name="rear_left_wheel_motor" joint="rear_left_wheel_spin"/>
    <motor name="rear_right_wheel_motor" joint="rear_right_wheel_spin"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="body" objname="chassis"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <framelinacc name="imu_accel" objtype="site" objname="imu_site"/>
  </sensor>
</mujoco>
